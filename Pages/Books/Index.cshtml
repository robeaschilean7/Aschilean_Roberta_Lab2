@page "/"
@model Aschilean_Roberta_Lab2.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get" class="mb-3">
    <div class="form-group">
        <label asp-for="AuthorFilterID" class="control-label">Author</label>
        <select asp-for="AuthorFilterID" class="form-control" asp-items="Model.AuthorList">
            <option value="">-- All authors --</option>
        </select>
    </div>
    <input type="submit" value="Filter" class="btn btn-primary mt-2" />
    <a asp-page="./Index" class="btn btn-secondary mt-2">Reset</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>PublishingDate</th>
            <th>Publisher</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";
            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @item.Author?.FullName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>
                <td>
                    @item.Publisher?.PublisherName
                </td>
                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            @category.Category.ID
                            @: @category.Category.CategoryName <br />
                        }
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>